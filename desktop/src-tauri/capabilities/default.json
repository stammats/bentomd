{
  "$schema": "../node_modules/@tauri-apps/cli/schema/capabilities/capability.json",
  "identifier": "default",
  "description": "Capability file for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-dir",
    "fs:scope-home-recursive"
  ]
}
